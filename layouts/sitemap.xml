{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
  {{- range site.AllPages -}}
    {{- if and (ne .Kind "taxonomy") (ne .Kind "term") (ne .Params.sitemap_exclude true) (ne .Draft true) (ne .Params.robots "noindex") -}}
      {{- if or (strings.HasSuffix .Permalink ".html") (strings.HasSuffix .Permalink "/") -}}
  <url>
    <loc>{{ .Permalink }}</loc>
    {{- if not .Lastmod.IsZero }}
    <lastmod>{{ .Lastmod.Format "2006-01-02T15:04:05+09:00" }}</lastmod>
    {{- else if not .Date.IsZero }}
    <lastmod>{{ .Date.Format "2006-01-02T15:04:05+09:00" }}</lastmod>
    {{- end }}
    <changefreq>{{ if .Params.changefreq }}{{ .Params.changefreq }}{{ else if .IsHome }}daily{{ else }}weekly{{ end }}</changefreq>
    <priority>{{ if .Params.priority }}{{ .Params.priority }}{{ else if .IsHome }}1.0{{ else if in (slice "treatments" "location" "about") .Section }}0.9{{ else }}0.8{{ end }}</priority>
  </url>
      {{- end -}}
    {{- end -}}
  {{- end -}}
</urlset>
